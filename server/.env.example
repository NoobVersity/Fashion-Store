# --- THREADS server configuration ---------------------------------------
# Copy this file to `server/.env` and fill in real values.
# Never commit the real .env file.

# Port the Express API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Secret used as a pepper when hashing passwords and session tokens.
# REQUIRED (and must be long + random) when NODE_ENV=production.
SESSION_SECRET=replace-with-a-long-random-string

# How long an admin login session stays valid.
SESSION_TTL_HOURS=8

# Optional: location of the SQLite database file.
# DATABASE_PATH=./data/threads.sqlite

# Initial administrator account. Used only by the local setup commands
# `npm run db:seed` and `npm run db:reset`. Leave ADMIN_PASSWORD empty in
# any shared file and set it locally; the seed command refuses to run
# without it.
ADMIN_EMAIL=admin@threads.local
ADMIN_PASSWORD=
